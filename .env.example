# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ======================
# Database Configuration
# ======================
# MongoDB connection string
# Local: mongodb://localhost:27017/floodguard
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/floodguard
MONGO_URI=mongodb://localhost:27017/floodguard

# ======================
# External API Keys
# ======================
# OpenWeatherMap API Key
# Get one at: https://openweathermap.org/api
OWM_KEY=your_openweathermap_api_key_here

# Note: Open-Meteo Flood API requires no key (free global coverage)
# Note: SoilGrids API requires no key (free global coverage)

# ======================
# Security
# ======================
# JWT Secret Key (use a random string)
JWT_SECRET=your_jwt_secret_key_here

# ======================
# Server Configuration
# ======================
# Server port
PORT=3000

# Node environment (development | production | test)
NODE_ENV=development

# CORS allowed origins (* for all, or specific domain)
CORS_ORIGIN=*

# ======================
# Default Location
# ======================
# Default coordinates for monitoring
# Lagos, Nigeria by default
DEFAULT_LAT=6.45
DEFAULT_LNG=3.39
DEFAULT_LOCATION_NAME=Lagos, Nigeria

# ======================
# Scheduling
# ======================
# Cron schedule for data ingestion
# Default: Every 10 minutes (*/10 * * * *)
# Format: minute hour day month dayOfWeek
CRON_SCHEDULE=*/10 * * * *

# ======================
# Firebase (Optional)
# ======================
# Firebase configuration is in firebase-service-account.json
# Leave this section empty unless you have custom Firebase settings
